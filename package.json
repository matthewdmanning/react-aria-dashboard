{
  "name": "react-aria-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "init": "tsx src/scripts/init-dashboard.ts",
    "build": "tsc --noEmit && vite build",
    "mcp": "tsx src/mcp/index.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format:check": "npx --yes prettier@3.6.2 --check \"**/*.md\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "react": "^19.1.1",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "tsx": "^4.23.12",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
